; Práctica: 5.1. Repetir hasta que el usuario ingrese cero 
; Descripción: Ciclo condicional que solicita números continuamente 
; y se repite mandando un mensaje de error hasta que el usuario teclee estrictamente el número 0.
; =====================================================================

INCLUDE Irvine32.inc

.data
    Mensaje1 BYTE "TECLEA EL NUMERO 0 : ", 0
    Mensaje2 BYTE "ERROR TECLEA EL NUMERO 0 : ", 0
    Num      SDWORD ?

.code
main PROC
    ; Primera lectura inicial
    mov edx, OFFSET Mensaje1
    call WriteString
    call ReadInt
    mov Num, eax
    call Crlf

    cmp eax, 0
    jne ciclo               ; Si no es cero, entra al bucle de validación

    exit

ciclo:
    mov edx, OFFSET Mensaje2
    call WriteString
    call ReadInt
    mov Num, eax
    call Crlf

    cmp eax, 0
    jne ciclo               ; Se mantiene iterando mientras EAX != 0

    exit         
main ENDP
END main